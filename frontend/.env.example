# ==============================================================================
# Virtual Reality Frontend Environment Configuration Template
# ==============================================================================

# Backend API base URL
# Default in development: /api (proxied by Vite to http://localhost:3000)
# Default on Vercel: /api (rewritten by vercel.json to Render backend)
# Set explicitly if frontend connects to backend on a separate domain directly:
# VITE_API_BASE_URL="https://virtual-reality-backend.onrender.com/api"
VITE_API_BASE_URL="/api"
