# ==============================================================================
# Virtual Reality Backend Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
# In production with connection poolers (Neon, Supabase, Render), use pooler URL with ?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/virtual_reality_dev?schema=public"

# Admin Authentication & Security
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET="development_jwt_secret_min_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"

# Media Storage (Cloudinary - Required in production)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# CORS Allowed Origins (Comma-separated in production)
# Example: https://www.virtual2reality.in,https://virtual2reality.in
ALLOWED_ORIGINS="https://www.virtual2reality.in,https://virtual2reality.in,http://localhost:5173"

# Public Site Configuration (Fallback metadata)
SITE_NAME="Virtual Reality"
SITE_TAGLINE="Discover Premium Real Estate"
SITE_DESCRIPTION="Explore premier residential and commercial properties curated by leading developers."
SITE_LOGO_URL="https://res.cloudinary.com/example/image/upload/logo.png"

# Web Push Notifications (VAPID - Optional for admin notifications)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@virtual2reality.in"

# Production Frontend Assets for SEO Pre-rendering (Optional fallback if frontend/dist is not co-located)
# VITE_ASSET_SCRIPT="/assets/index.js"
# VITE_ASSET_STYLE="/assets/index.css"
