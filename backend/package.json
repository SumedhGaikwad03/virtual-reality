{
  "name": "backend",
  "version": "1.0.0",
  "description": "VR Backend for enquiry form",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --import dotenv/config dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "admin:create": "tsc -p tsconfig.json && node dist/src/scripts/create-admin.js",
    "audit:db": "tsx src/scripts/audit-db.ts",
    "import:catalog": "tsx src/scripts/import-property-catalog.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^157.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
