// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  SOLD_OUT
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  READY_TO_MOVE
  COMPLETED
  SOLD_OUT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}

enum MediaCategory {
  HERO
  HERO_CAROUSEL
  CARD
  GALLERY
  AMENITY
  EXTERIOR
  INTERIOR
  LOCATION
  CONSTRUCTION
  FLOOR_PLAN
  BROCHURE
  PROJECT_VIDEO
  DEVELOPER_BANNER
  DEVELOPER_HERO
}

enum MediaSource {
  MANUAL
  SCRAPED
  IMPORTED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum AdminRole {
  FOUNDER
  EMPLOYEE
}

model Developer {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  logoUrl       String?
  websiteUrl    String?
  publishStatus PublishStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  media    Media[]
  leads    Lead[]
}

model Configuration {
  id                 String             @id @default(uuid())
  name               String
  bhk                Int
  carpetArea         Int
  builtUpArea        Int?
  superBuiltUpArea   Int?
  priceFrom          BigInt
  availabilityStatus AvailabilityStatus

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]
  leads Lead[]

  @@index([projectId])
}

model Project {
  id            String        @id @default(uuid())
  developerId   String
  developer     Developer     @relation(fields: [developerId], references: [id])

  name          String
  slug          String
  description   String?
  locationName  String
  locationSlug  String
  address       String
  mapsUrl       String?
  status        ProjectStatus
  featured      Boolean       @default(false)
  publishStatus PublishStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configurations Configuration[]
  media          Media[]
  highlights     ProjectHighlight[]
  amenities      ProjectAmenity[]
  leads          Lead[]

  @@unique([developerId, slug])
  @@index([developerId])
  @@index([publishStatus, featured])
}

model ProjectHighlight {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  text      String
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ProjectAmenity {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  name      String
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Media {
  id              String         @id @default(uuid())

  developerId     String?
  developer       Developer?     @relation(fields: [developerId], references: [id], onDelete: SetNull)

  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  context         MediaContext
  slot            String?

  type            MediaType
  category        MediaCategory

  title           String?
  url             String
  thumbnailUrl    String?
  altText         String?

  sortOrder       Int            @default(0)
  isPrimary       Boolean        @default(false)
  isActive        Boolean        @default(true)

  source          MediaSource
  sourceUrl       String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  firmProfiles    FirmProfile[]

  @@index([developerId])
  @@index([projectId])
  @@index([configurationId])
  @@index([context, isActive])
}

model Lead {
  id    String @id @default(uuid())
  name  String
  phone String
  email String?

  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id])

  message String?
  status  LeadStatus @default(NEW)
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([developerId])
  @@index([projectId])
  @@index([configurationId])
  @@index([status])
}

model Admin {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  name                String?
  role                AdminRole           @default(EMPLOYEE)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
}

model PushSubscription {
  id          String   @id @default(uuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?

  @@index([adminId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model FirmContact {
  id                String   @id @default("default")
  contactPersonName String   @default("Dipankar Jagtap")
  phone             String   @default("+91 89996 43665")
  email             String   @default("dipankarjagtap@virtual2reality.in")
  address           String   @default("Office No. 202, 2nd Floor\nMspace Mall, Near Mahindra Antheia\nPimpri, Pune 411018")
  googleMapsUrl     String?
  whatsappUrl       String   @default("https://api.whatsapp.com/send/?phone=918999643665&text&type=phone_number&app_absent=0")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FirmProfile {
  id                  String   @id @default("default")
  founderName         String   @default("Dipankar Jagtap")
  founderTitle        String   @default("Founder of Virtual Reality")
  founderExperience   String   @default("20+ years of experience in the real estate industry")
  founderBio          String?
  founderImageMediaId String?
  founderImageMedia   Media?   @relation(fields: [founderImageMediaId], references: [id], onDelete: SetNull)
  companyDescription  String?  @default("Virtual Reality is a real-estate discovery platform showcasing prime residential developments and architectural landmarks.")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([founderImageMediaId])
}

enum MediaContext {
  HOME
  DEVELOPER
  PROJECT
  CONFIGURATION
}
